# Copia este archivo como .env y completa los valores.
# Local: SQLite (no requiere instalar nada). Producción: postgresql+psycopg://usuario:clave@host/db
DATABASE_URL=sqlite:///./mikuy.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Mikuy AI (opcional): sin clave funciona el intérprete local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Pagos: true = simulados con código de activación.
PAYMENTS_SIMULATED=true
